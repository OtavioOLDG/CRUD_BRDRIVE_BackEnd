generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Zookeeper {
  id            String    @id @default(uuid())
  nome          String
  cpf           String    @unique
  idade         Int
  especialidade String

  // Relacionamento: Um cuidador tem vários animais
  animais    Animal[]  
}

model Animal {
  id          String    @id @default(uuid())
  nome        String
  especie     String
  idade       Int
  habitat     String
  criadoEm    DateTime @default(now())
  
  // Relacionamento um animal tem um responsável
  cuidadorId String
  cuidador   Zookeeper @relation(fields: [cuidadorId], references: [id])
}
